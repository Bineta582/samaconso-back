APP_NAME=SamaConso
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dakar
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# URL du frontend Angular (liens des emails) et origines autorisées (CORS, séparées par des virgules)
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données PostgreSQL --------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sama_conso1
DB_USERNAME=postgres
DB_PASSWORD=passer

# API stateless : pas de session web
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# --- JWT (tymon/jwt-auth) ----------------------------------------------------------------------
# Générer la clé avec : php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# --- Emails (alertes, rapport hebdomadaire) ----------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@samaconso.sn
MAIL_FROM_NAME="${APP_NAME}"

# --- MQTT (broker Mosquitto) ------------------------------------------------------------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=samaconso-backend
MQTT_PASSWORD=passer
MQTT_CLIENT_ID=samaconso-backend
MQTT_TOPIC_ROOT=samaconso
# En production : TLS activé (port 8883) avec l'autorité de certification du broker
MQTT_TLS=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_CA_FILE=
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=

# --- Microservice Python de prédiction ---------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=a737161bcc1199b49867051667b65a8995441ad24fbc24b1d24233ee10328ecb
ML_SERVICE_TIMEOUT=20

# --- Paiements : "simulated" tant qu'aucun contrat marchand n'est signé --------------------------
PAYMENT_DRIVER=simulated
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- SMS : "log" (développement) ou "http" -----------------------------------------------------
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=SamaConso

# --- Exploitation --------------------------------------------------------------------------------
CAPTEUR_HORS_LIGNE_MINUTES=10
RETENTION_MESURES_JOURS=30

# --- Seeders -------------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@samaconso.sn
SEED_ADMIN_PASSWORD=Admin#2026
SEED_DEMO=true
